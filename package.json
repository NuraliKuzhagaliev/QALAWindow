{
  "name": "qala-window",
  "version": "0.1.3",
  "private": true,
  "type": "module",
  "description": "Evidence-backed short walks in Astana",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "api": "tsx apps/api/server.ts",
    "build": "node scripts/sync-data.mjs && vite build && node scripts/generate-sw.mjs && esbuild apps/api/server.ts --platform=node --packages=external --bundle --format=esm --outfile=dist/server.mjs",
    "start": "node dist/server.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "collect": "node scripts/data/collect.mjs",
    "build:pages": "node scripts/build-pages.mjs",
    "desktop": "electron apps/desktop/main.cjs",
    "package:win": "npm run build && electron-builder --win portable --x64",
    "lint": "eslint apps packages scripts tests vite.config.ts"
  },
  "main": "apps/desktop/main.cjs",
  "build": {
    "appId": "kz.qala.window",
    "productName": "QALA Window",
    "directories": {
      "output": "release/windows"
    },
    "files": [
      "dist/client/**/*",
      "apps/desktop/*.cjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "data/snapshots",
        "to": "data"
      }
    ],
    "win": {
      "target": "portable",
      "signAndEditExecutable": false,
      "icon": "assets/qala.ico"
    },
    "artifactName": "QALAWindow-${version}-Windows-x64.${ext}"
  },
  "dependencies": {
    "@fontsource/manrope": "^5.3.0",
    "@fontsource/noto-sans": "^5.3.0",
    "@hono/node-server": "^2.1.11",
    "hono": "^4.13.20",
    "idb": "^8.0.4",
    "lucide-react": "^1.59.0",
    "maplibre-gl": "^6.15.0",
    "opening_hours": "^3.15.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "44.11.5",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.4"
  }
}
